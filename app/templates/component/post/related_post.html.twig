{% trans_default_domain 'blog_post' %}

<h2 class="text-center mt-130 pb-30 mb-60">{{ 'relatd_post' | trans | capitalize }}</h2>

<div class="row gh-1 gv-1 mb-n8">
    {% for post in this.pages %}
        {% if post.publishedState == true %}
            <div class="col-12 col-md-6 col-lg-4 show-on-scroll" data-show-duration="600" data-show-distance="20" data-show-delay="50">
                <a class="card card-blog card-vertical" href="{{ sulu_content_path(post.url) }}">
            <span class="card-img">
                <img src="" alt="">
                {% if post.excerptImages|length > 0 %}
                    <img src="{{ post.excerptImages[0].thumbnails['50x50'] }}" alt="{{ post.excerptImages[0].title }}"/>
                {% endif %}
            </span>
                    <span class="card-body">
                <span class="card-title h5">{{ post.title }}</span>
                <span class="card-date">{{ post.published | date("m/d/Y") }}</span>
            </span>
                </a>
            </div>
        {% endif %}
    {% endfor %}
</div>