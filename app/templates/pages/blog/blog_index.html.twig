{% extends 'base.html.twig' %}
{% trans_default_domain 'blog_index' %}

{% block content %}

<div class="content-wrap">
    <div class="container">
        {% set categories = [] %}
        {% for teaserPost in content.teaser_posts %}
            {% set post = sulu_content_load(teaserPost.single_teaser_post, {
                'category': 'category',
            }) %}

            {% set categoryName = post.content.category.name %}
            {% if categoryName not in categories %}
                {% set categories = categories | merge([categoryName]) %}
            {% endif %}
        {% endfor %}

        {{ component('swiper', {
            blogPosts: content.teaser_posts
        }) }}

        <div class="isotope">
            <ul class="nav justify-content-center isotope-options mb-60 pb-30">
                <li class="nav-item ">
                    <a href="#all" data-filter="all" class="nav-link filter">
                        <div class="nav-link-name">{{ 'all_posts' | trans}}</div>
                    </a>
                </li>

                {% for category in categories %}
                    <li class="nav-item ">
                        <a href="#{{ category }}" data-filter="{{ category }}" class="nav-link filter">
                            <div class="nav-link-name">{{ category }}</div>
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <div class="row gh-1 gv-4 isotope-grid">
                {% for blogPost in content.teaser_posts %}
                    {% set post = sulu_content_load(blogPost.single_teaser_post, {
                        'title_on_index': 'title_on_index',
                        'preview_teaser': 'preview_teaser',
                        'image': 'image',
                        'readTime': 'readTime',
                        'publishedAt': 'publishedAt',
                        'category': 'category',
                        'blogpost_type': 'blogpost_type',
                        'date_update': 'date_update'
                    }) %}

                    <div class="col-12 col-md-6 col-lg-4 isotope-item post" data-filter="{{ post.content.category.name }}">
                        <div class="card card-blog card-vertical">
                            {% if post.content.image != '' %}
                                <sulu-link href="{{ blogPost.single_teaser_post }}" class="card-img" >
                                    <img src="{{ post.content.image.thumbnails['360x.webp'] }}" alt="{{ post.content.image.title }}" title="{{ post.content.image.description|default(post.content.image.title) }}">
                                </sulu-link>
                            {% endif %}
                            <div class="card-body">
                                <sulu-link href="{{ blogPost.single_teaser_post }}" class="card-title h5">{{ post.content.title_on_index | replace({'<p>': '', '</p>': ''}) | raw }}</sulu-link>
                                <div class="card-date">{{ post.content.publishedAt | date("m/d/Y") }}</div>
                                <p class="card-text">{{ post.content.preview_teaser }}</p>
                                <sulu-link href="{{ blogPost.single_teaser_post }}" class="btn btn-clean">{{ 'read_more' | trans}}<svg class='icon-arrow icon-arrow-right' width='25' height='10' viewBox='0 0 25 10' fill='none' xmlns='http://www.w3.org/2000/svg'>
                                        <path d='M20 1L24 5L20 9' stroke='currentColor' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round' />
                                        <path d='M7 5L24 5' stroke='currentColor' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round' />
                                    </svg>
                                </sulu-link>
                            </div>
                        </div>
                    </div>

                {% endfor %}
            </div>
            <div class="text-center mt-100">
                <a href="" class="btn btn-light btn-circle btn-lg">{{ 'more_blog_posts' | trans }}</a>
            </div>
        </div>
    </div>
</div>


{% endblock %}
{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('blogIndex') }}

{% endblock %}